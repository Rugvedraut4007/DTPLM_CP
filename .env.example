# StudyMarket — environment template (safe to commit; contains NO real secrets)
#
# Copy this file to `.env`, fill in your values, then load it:
#
#   macOS / Linux / Git Bash      set -a; source .env; set +a
#   Windows PowerShell            Get-Content .env | ForEach-Object {
#                                   if ($_ -match '^([^#=]+)=(.*)$') {
#                                     [Environment]::SetEnvironmentVariable(
#                                       $matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#
# `.env` is gitignored. Never put real passwords in this template file.

# --- Backend (required for the real Postgres setup) ---
# Password for the `postgres` user. Spring Boot reads ${STUDYMARKET_DB_PASSWORD}
# from backend/src/main/resources/application.properties.
STUDYMARKET_DB_PASSWORD=change-me

# --- Frontend / dev-server overrides (optional) ---
#VITE_API_TARGET=http://localhost:8080
#MOCK_API_PORT=8080
